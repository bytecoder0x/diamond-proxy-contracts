{
  "name": "diamond-proxy-contracts",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "lint": "npm run lint:ts && npm run lint:sol",
    "lint:ts": "eslint . --ext .ts,.tsx",
    "lint:ts:fix": "eslint . --ext .ts,.tsx --fix",
    "lint:sol": "solhint -f table \"contracts/**/*.sol\"",
    "lint:sol:fix": "solhint --fix -f table \"contracts/**/*.sol\"",
    "lint:fix": "npm run lint:ts:fix && npm run lint:sol:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:style": "npm run lint && npm run format:check",
    "fix:style": "npm run lint:fix && npm run format",
    "deploy-polygon": "npx hardhat ignition deploy --network polygon ignition/modules/diamond-deploy.ts",
    "setup-polygon": "npx hardhat ignition deploy --network polygon ignition/modules/diamond-setup.ts",
    "typechain-diamond": "npx typechain --target ethers-v6 --out-dir typechain \"artifacts/contracts/Diamond.sol/Diamond.json\""
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^3.0.3",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.0.0",
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "@typechain/ethers-v6": "^0.5.1",
    "@types/node": "^22.18.3",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.0.6",
    "prettier": "^3.6.2",
    "prettier-plugin-solidity": "^2.1.0",
    "solhint": "^6.0.1",
    "typechain": "^8.3.2",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.45.0",
    "viem": "^2.37.6"
  }
}
